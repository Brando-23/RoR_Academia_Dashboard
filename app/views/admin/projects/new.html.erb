<div class="container mt-5">

  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">

      <div class="card shadow-lg border-0">
        <div class="card-body p-4">

          <h3 class="mb-4 fw-bold text-center">Create New Project</h3>

          <%= form_with model: [:admin, @project] do |form| %>

            <div class="mb-3">
              <%= form.label :title, class: "form-label fw-semibold" %>
              <%= form.text_field :title, class: "form-control", placeholder: "Enter project title" %>
            </div>

            <div class="mb-3">
              <%= form.label :description, class: "form-label fw-semibold" %>
              <%= form.text_area :description, class: "form-control", rows: 4, placeholder: "Enter project description" %>
            </div>

            <div class="d-grid">
              <%= form.submit "Create Project", class: "btn btn-primary btn-lg shadow-sm" %>
            </div>

          <% end %>

          <div class="text-center mt-3">
            <%= link_to "Back to Projects", admin_projects_path, class: "text-decoration-none" %>
          </div>

        </div>
      </div>

    </div>
  </div>

</div>